# Copia este archivo a .env y completa los valores reales. Nunca commitear .env.
# Los valores "change-me" son placeholders de ejemplo, NO secretos válidos: generar
# los reales con, por ejemplo, `openssl rand -hex 32` (JWT) o
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` (TOTP).

# --- Fase 1: base de datos y JWT ---
# Driver psycopg3 (psycopg[binary]); requiere el servicio "postgres" de docker-compose.yml.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/spotify_clone
# Base de datos separada usada solo por tests/ (se crea automáticamente vía
# docker/postgres-init/01-create-test-db.sql al levantar el contenedor).
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/spotify_clone_test
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Cookie del refresh token: True en producción (requiere HTTPS). Poner en False solo
# para desarrollo local por http:// si el navegador no manda la cookie Secure.
COOKIE_SECURE=true

# --- Fase 3: 2FA (TOTP) ---
TOTP_ENCRYPTION_KEY=change-me

# --- Fase 6: rate limiter ---
REDIS_URL=redis://localhost:6379/0

# --- Fase 8: almacenamiento de audio (MinIO, compatible S3) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_NAME=songs

# --- Fase 9: streaming (presigned URLs) ---
# Endpoint que debe poder resolver el NAVEGADOR del cliente para consumir una
# URL firmada - distinto de S3_ENDPOINT_URL (que dentro de docker-compose.yml
# se sobreescribe a "http://minio:9000", no resoluble fuera del contenedor).
# No es un secreto.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# --- Fase 10: búsqueda ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=change-me

# --- Fase 11: recomendaciones precalculadas (Celery) ---
# Mismo Redis que REDIS_URL, DB 1 en vez de DB 0 (no es un secreto).
CELERY_BROKER_URL=redis://localhost:6379/1
