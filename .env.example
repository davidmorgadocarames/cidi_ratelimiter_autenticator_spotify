# Copia este archivo a .env y completa los valores reales. Nunca commitear .env.
# Los valores "change-me" son placeholders de ejemplo, NO secretos válidos: generar
# los reales con, por ejemplo, `openssl rand -hex 32` (JWT) o
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` (TOTP).

# --- Fase 1: base de datos y JWT ---
# Driver de Postgres (psycopg2 vs psycopg3) aún no decidido; se fija en Fase 1.
DATABASE_URL=postgresql://user:password@localhost:5432/spotify_clone
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Fase 3: 2FA (TOTP) ---
TOTP_ENCRYPTION_KEY=change-me

# --- Fase 6: rate limiter ---
REDIS_URL=redis://localhost:6379/0

# --- Fase 8: almacenamiento de audio (MinIO, compatible S3) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_NAME=songs

# --- Fase 10: búsqueda ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=change-me
